{
	"name": "Knit-Tests",
	"globIgnorePaths": [
		"**/.package-lock.json",
		"**/start.server.luau",
		"**/start.client.luau",
		"**/ReplicatedFirst"
	],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"Packages": {
				"$className": "Folder",
				"Knit": {
					"$path": "src"
				}
			},

			"Controllers": {
				"$path": "Test/Controllers"
			}
		},

		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Client": {
					"$path": "Test/Client.client.luau"
				}
			}
		},

		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Services": {
				"$path": "Test/Services"
			},

			"Server": {
				"$path": "Test/Server.server.luau"
			}
		}
	}
}
